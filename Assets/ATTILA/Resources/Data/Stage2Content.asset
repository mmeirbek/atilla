    finaleTitle: "I \u0422\u0410\u0420\u0410\u0423 \u0410\u042F\u049A\u0422\u0410\u041B\u0414\u042B"
    finaleText: "\u041A\u04E9\u0448 \u0416\u0435\u0442\u0456\u0441\u0443\u0493\u0430 \u0430\u043C\u0430\u043D \u0436\u0435\u0442\u0442\u0456. \u0416\u0430\u04A3\u0430 \u049B\u043E\u043D\u044B\u0441\u049B\u0430 \u043E\u0440\u043D\u044B\u049B\u049B\u0430\u043D \u0435\u043B \u043A\u0435\u0439\u0456\u043D \u049A\u0430\u0437\u0430\u049B \u0445\u0430\u043D\u0434\u044B\u0493\u044B \u0434\u0435\u0433\u0435\u043D \u0430\u0442\u043F\u0435\u043D \u0442\u0430\u0440\u0438\u0445\u0442\u0430 \u049B\u0430\u043B\u0434\u044B."
