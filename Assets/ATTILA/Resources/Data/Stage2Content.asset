  - id: DIA_B_AISHA
    speakerName: "\u0410\u0439\u0448\u0430"
    speakerLook: woman
    lines:
    - "\u0410\u043D\u0430 \u043C\u0435\u043D \u0431\u0430\u043B\u0430 \u0442\u0430\u0443\u0434\u0430\u0493\u044B \u0436\u0430\u0441\u044B\u0440\u044B\u043D \u0436\u0430\u0439\u043B\u0430\u0443\u0493\u0430 \u043A\u04E9\u0448\u0442\u0456."
    - "\u0410\u0443\u044B\u043B \u0441\u0456\u0437\u0433\u0435 \u0441\u0435\u043D\u0435\u0434\u0456, \u0431\u0430\u0442\u044B\u0440. \u0410\u043C\u0430\u043D \u043E\u0440\u0430\u043B\u044B\u04A3\u044B\u0437."
