    speakerName: "\u04B0\u043B\u044B \u0436\u04AF\u0437 \u0435\u043B\u0448\u0456\u0441\u0456"
    speakerLook: envoy2
    lines:
    - "\u041A\u0435\u04A3\u0435\u0441\u0442\u0456 \u0435\u043B \u0430\u0437\u0431\u0430\u0439\u0434\u044B. \u0422\u04AF\u0440\u043A\u0456\u0441\u0442\u0430\u043D\u0434\u0430\u0493\u044B \u0436\u0438\u044B\u043D\u0434\u0430 \u043A\u0435\u0437\u0434\u0435\u0441\u0435\u043C\u0456\u0437."
