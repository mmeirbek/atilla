  - id: DIA_A_ENVOY_S
    speakerName: "\u04B0\u043B\u044B \u0436\u04AF\u0437 \u0435\u043B\u0448\u0456\u0441\u0456"
    speakerLook: envoy2
    lines:
    - "\u041E\u04A3\u0442\u04AF\u0441\u0442\u0456\u043A\u0442\u0435 \u043A\u0435\u0440\u0443\u0435\u043D \u0436\u043E\u043B\u044B \u049B\u0430\u0443\u0456\u043F\u0442\u0456. \u0422\u04AF\u0440\u043A\u0456\u0441\u0442\u0430\u043D \u043C\u0430\u04A3\u044B \u0442\u044B\u043D\u044B\u0448 \u0431\u043E\u043B\u0443\u044B \u043A\u0435\u0440\u0435\u043A."
    - "\u0411\u0456\u0437 \u0441\u0456\u0437\u0434\u0435\u043D \u049B\u043E\u043B\u0434\u0430\u0443 \u043A\u04AF\u0442\u0435\u043C\u0456\u0437."
