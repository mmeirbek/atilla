    speakerLook: elder
    lines:
    - "\u049A\u04B1\u0440\u043C\u0435\u0442\u0442\u0456 \u043A\u0456\u0441\u0456\u0433\u0435 \u0448\u0430\u043F\u0430\u043D \u0436\u0430\u0431\u0443 \u2014 \u0456\u0437\u0435\u0442 \u043F\u0435\u043D \u0441\u044B\u0439\u0434\u044B\u04A3 \u0431\u0435\u043B\u0433\u0456\u0441\u0456."
    - "\u0428\u0430\u043F\u0430\u043D\u043D\u044B\u04A3 \u0441\u04D9\u043D\u0456 \u0434\u0435, \u0436\u044B\u043B\u0443\u044B \u0434\u0430 \u2014 \u0448\u0435\u0431\u0435\u0440\u0456\u043D\u0456\u04A3 \u049B\u043E\u043B\u044B\u043D\u0434\u0430."
