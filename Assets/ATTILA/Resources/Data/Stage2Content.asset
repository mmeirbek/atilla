  - id: DIA_A_ROUTE
    speakerName: "\u0411\u0438"
    speakerLook: bi
    lines:
    - "\u049A\u0430\u043B\u0430 \u049B\u0430\u049B\u043F\u0430\u0441\u044B \u0430\u0448\u044B\u049B, \u04AF\u0448 \u0436\u04AF\u0437\u0434\u0456\u04A3 \u04E9\u043A\u0456\u043B\u0434\u0435\u0440\u0456 \u0436\u0438\u043D\u0430\u043B\u044B\u043F \u049B\u0430\u043B\u0434\u044B."
    - "\u0415\u043B \u0430\u043B\u0434\u044B\u043D\u0430 \u0448\u044B\u0493\u0430\u0442\u044B\u043D \u0443\u0430\u049B\u044B\u0442 \u0436\u0435\u0442\u0442\u0456."
