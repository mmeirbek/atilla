    speakerName: "\u0411\u0430\u0440\u043B\u0430\u0443\u0448\u044B"
    speakerLook: envoy
    lines:
    - "\u0411\u0430\u0442\u044B\u0441 \u0436\u0430\u049B\u0442\u0430\u0493\u044B \u0442\u0430\u0441\u0442\u0430\u0440\u0434\u044B\u04A3 \u0430\u0440\u0430\u0441\u044B\u043D\u0430\u043D \u0436\u0430\u0443 \u0456\u0437\u0456 \u043A\u04E9\u0440\u0456\u043D\u0434\u0456."
    - "\u0411\u0430\u0440\u044B\u043F \u04E9\u0437 \u043A\u04E9\u0437\u0456\u04A3\u043C\u0435\u043D \u049B\u0430\u0440\u0430 \u2014 \u0431\u0456\u0437 \u043C\u04B1\u043D\u0434\u0430 \u043A\u04AF\u0437\u0435\u043C\u0456\u0437."
