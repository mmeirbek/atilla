  dialogues:
  - id: DIA_K_BI
    speakerName: "\u0411\u0438"
    speakerLook: bi
    lines:
    - "\u041A\u0435\u0440\u0435\u0439 \u0441\u04B1\u043B\u0442\u0430\u043D, \u04D8\u0431\u0456\u043B\u049B\u0430\u0439\u044B\u0440 \u043E\u0440\u0434\u0430\u0441\u044B\u043D\u0434\u0430 \u0442\u044B\u043D\u044B\u0448\u0442\u044B\u049B \u0436\u043E\u049B. \u041A\u04E9\u043F \u0430\u0443\u044B\u043B \u0430\u0443\u0430 \u043A\u04E9\u0448\u0443\u0433\u0435 \u0431\u0435\u043B \u0431\u0443\u0434\u044B."
    - "\u0416\u04D9\u043D\u0456\u0431\u0435\u043A \u0441\u04B1\u043B\u0442\u0430\u043D \u0434\u0430 \u043E\u0441\u044B \u043E\u0439\u0434\u0430. \u0428\u0443 \u0431\u043E\u0439\u044B\u043D\u0434\u0430, \u0416\u0435\u0442\u0456\u0441\u0443\u0434\u0430 \u0436\u0435\u0440 \u043A\u0435\u04A3, \u0436\u0430\u0439\u044B\u043B\u044B\u043C \u043C\u043E\u043B."
    - "\u0415\u043B \u0441\u0456\u0437\u0434\u0456\u04A3 \u0448\u0435\u0448\u0456\u043C\u0456\u04A3\u0456\u0437\u0434\u0456 \u043A\u04AF\u0442\u0456\u043F \u043E\u0442\u044B\u0440. \u041D\u0435 \u0430\u0439\u0442\u0430\u0441\u044B\u0437?"
    choices:
    - label: "\u041A\u04E9\u0448\u0442\u0456 \u0431\u0430\u0441\u0442\u0430\u0439\u043C\u044B\u0437"
      nextDialogueId: DIA_K_BI_GO
      setFlag: bold
      xp: 10
      unity: 0
    - label: "\u0410\u043B\u0434\u044B\u043C\u0435\u043D \u0435\u043B\u0434\u0456\u04A3 \u043E\u0439\u044B\u043D \u0442\u044B\u04A3\u0434\u0430\u0439\u044B\u049B"
      nextDialogueId: DIA_K_BI_LISTEN
      setFlag: listen
      xp: 20
      unity: 20
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: "[\u041F\u0420\u041E\u0412\u0415\u0420\u0418\u0422\u042C] \u043E\u0442\u043A\u043E\u0447\u0451\u0432\u043A\u0430 \u043E\u0442 \u0410\u0431\u0443\u043B\u0445\u0430\u0438\u0440\u0430 \u043A \u0416\u0435\u0442\u044B\u0441\u0443 \u2014 \u0441\u0432\u0435\u0440\u0438\u0442\u044C \u0441 \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u043E\u043C \xAB\u049A\u0430\u0437\u0430\u049B\u0441\u0442\u0430\u043D \u0442\u0430\u0440\u0438\u0445\u044B\xBB"
  - id: DIA_K_BI_GO
    speakerName: "\u0411\u0438"
    speakerLook: bi
    lines:
    - "\u0411\u0430\u0442\u044B\u043B \u0448\u0435\u0448\u0456\u043C. \u0411\u0456\u0440\u0430\u049B \u049B\u0430\u0440\u0442 \u043F\u0435\u043D \u0431\u0430\u043B\u0430\u043D\u044B \u04B1\u043C\u044B\u0442\u043F\u0430\u04A3\u044B\u0437 \u2014 \u043A\u04E9\u0448 \u0441\u043E\u043B\u0430\u0440\u0434\u044B\u04A3 \u049B\u0430\u0440\u049B\u044B\u043D\u044B\u043C\u0435\u043D \u0436\u04AF\u0440\u0435\u0434\u0456."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_BI_LISTEN
    speakerName: "\u0411\u0438"
    speakerLook: bi
    lines:
    - "\u0414\u0430\u043D\u0430 \u0441\u04E9\u0437. \u0415\u043B\u0434\u0456\u04A3 \u043A\u0435\u043B\u0456\u0441\u0456\u043C\u0456 \u2014 \u043A\u04E9\u0448\u0442\u0456\u04A3 \u0431\u0435\u0440\u0456\u043A \u049B\u0430\u0437\u044B\u0493\u044B. \u0410\u0439\u0448\u0430 \u0434\u0430\u0439\u044B\u043D\u0434\u044B\u049B\u0442\u044B \u0431\u0430\u0441\u0442\u0430\u043F \u049B\u043E\u0439\u0434\u044B."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_AISHA
    speakerName: "\u0410\u0439\u0448\u0430"
    speakerLook: woman
    lines:
    - "\u041A\u04E9\u0448 \u0430\u043B\u0434\u044B\u043D\u0434\u0430 \u043E\u0442 \u0436\u0430\u0493\u0430\u043C\u044B\u0437, \u0431\u0456\u0440\u0430\u049B \u043E\u0442\u044B\u043D \u0436\u0435\u0442\u043F\u0435\u0439 \u0442\u04B1\u0440."
    - "\u0410\u0443\u044B\u043B \u043C\u0430\u04A3\u044B\u043D\u0430\u043D \u0442\u04E9\u0440\u0442 \u0431\u0443\u043C\u0430 \u043E\u0442\u044B\u043D \u0436\u0438\u043D\u0430\u043F \u04D9\u043A\u0435\u043B\u0448\u0456."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_AISHA_DONE
    speakerName: "\u0410\u0439\u0448\u0430"
    speakerLook: woman
    lines:
    - "\u041E\u0442\u044B\u043D \u0436\u0435\u0442\u0435\u0434\u0456, \u0440\u0430\u049B\u043C\u0435\u0442. \u049A\u0430\u0437\u0430\u043D \u0430\u0441\u044B\u043B\u0430\u0434\u044B."
    - "\u0415\u043D\u0434\u0456 \u043C\u0430\u043B\u0448\u044B\u0493\u0430 \u043A\u04E9\u043C\u0435\u043A\u0442\u0435\u0441: \u0436\u0430\u04A3\u0430 \u049B\u043E\u043D\u044B\u0441\u049B\u0430 \u043A\u0438\u0456\u0437 \u04AF\u0439 \u0442\u0456\u0433\u0443 \u043A\u0435\u0440\u0435\u043A."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_HERDER
    speakerName: "\u041C\u0430\u043B\u0448\u044B"
    speakerLook: resident
    lines:
    - "\u041A\u0438\u0456\u0437 \u04AF\u0439\u0434\u0456\u04A3 \u0431\u04E9\u043B\u0456\u043A\u0442\u0435\u0440\u0456 \u0448\u0430\u0448\u044B\u043B\u044B\u043F \u0436\u0430\u0442\u044B\u0440: \u043A\u0435\u0440\u0435\u0433\u0435, \u0443\u044B\u049B, \u0448\u0430\u04A3\u044B\u0440\u0430\u049B, \u043A\u0438\u0456\u0437."
    - "\u0420\u0435\u0442\u0456\u043C\u0435\u043D \u04D9\u043A\u0435\u043B: \u0430\u043B\u0434\u044B\u043C\u0435\u043D \u043A\u0435\u0440\u0435\u0433\u0435, \u0441\u043E\u0441\u044B\u043D \u0443\u044B\u049B, \u0448\u0430\u04A3\u044B\u0440\u0430\u049B, \u0435\u04A3 \u0441\u043E\u04A3\u044B\u043D\u0434\u0430 \u043A\u0438\u0456\u0437."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_CHILDREN
    speakerName: "\u0411\u0430\u043B\u0430\u043B\u0430\u0440"
    speakerLook: child
    lines:
    - "\u0421\u04B1\u043B\u0442\u0430\u043D \u0430\u0493\u0430, \u043A\u04E9\u0448 \u0430\u043B\u0434\u044B\u043D\u0434\u0430 \u0431\u0456\u0437\u0431\u0435\u043D \u043E\u0439\u043D\u0430\u04A3\u044B\u0437\u0448\u044B!"
    - "\u0421\u0456\u0437 \xAB\u0442\u0435\u043A\u0435\xBB \u0431\u043E\u043B\u0430\u0441\u044B\u0437: \u043A\u04E9\u0437\u0456\u04A3\u0456\u0437\u0434\u0456 \u0431\u0430\u0439\u043B\u0430\u0439\u043C\u044B\u0437, \u0430\u043B \u0431\u0456\u0437 \u0448\u0430\u043F\u0430\u043B\u0430\u049B \u0441\u043E\u0493\u0430\u043C\u044B\u0437!"
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_ELDER
    speakerName: "\u0410\u049B\u0441\u0430\u049B\u0430\u043B"
    speakerLook: elder
    lines:
    - "\u041A\u04E9\u0448 \u0430\u043B\u0434\u044B\u043D\u0434\u0430\u0493\u044B \u0441\u043E\u04A3\u0493\u044B \u0442\u04AF\u043D. \u041E\u0442\u049B\u0430 \u0436\u0430\u049B\u044B\u043D \u043E\u0442\u044B\u0440\u044B\u04A3\u044B\u0437, \u04D9\u04A3\u0433\u0456\u043C\u0435 \u0430\u0439\u0442\u0430\u0439\u044B\u043D."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_T1
    speakerName: "\u0410\u049B\u0441\u0430\u049B\u0430\u043B"
    speakerLook: elder
    lines:
    - "\u04D8\u0431\u0456\u043B\u049B\u0430\u0439\u044B\u0440 \u0445\u0430\u043D \u0442\u04B1\u0441\u044B\u043D\u0434\u0430 \u0440\u0443 \u0431\u0430\u0441\u044B\u043B\u0430\u0440\u044B \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430 \u0430\u043B\u0430\u0443\u044B\u0437\u0434\u044B\u049B \u043A\u04E9\u0431\u0435\u0439\u0434\u0456."
    - "\u0415\u043B\u0434\u0456\u04A3 \u0431\u0456\u0440 \u0431\u04E9\u043B\u0456\u0433\u0456 \u041A\u0435\u0440\u0435\u0439 \u043C\u0435\u043D \u0416\u04D9\u043D\u0456\u0431\u0435\u043A\u043A\u0435 \u0435\u0440\u0456\u043F, \u041C\u043E\u0493\u043E\u043B\u0441\u0442\u0430\u043D \u0448\u0435\u043A\u0430\u0440\u0430\u0441\u044B\u043D\u0430 \u049B\u0430\u0440\u0430\u0439 \u043A\u04E9\u0448\u0442\u0456."
    - "\u041E\u0441\u044B \u043A\u04E9\u0448 \u049A\u0430\u0437\u0430\u049B \u0445\u0430\u043D\u0434\u044B\u0493\u044B\u043D\u044B\u04A3 \u0431\u0430\u0441\u0442\u0430\u0443\u044B \u0431\u043E\u043B\u0434\u044B \u0434\u0435\u043F \u0430\u0439\u0442\u044B\u043B\u0430\u0434\u044B."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: "[\u041F\u0420\u041E\u0412\u0415\u0420\u0418\u0422\u042C] \u043F\u0440\u0438\u0447\u0438\u043D\u044B \u043E\u0442\u043A\u043E\u0447\u0451\u0432\u043A\u0438 \u0438 \u0435\u0451 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  - id: DIA_K_T2
    speakerName: "\u0410\u049B\u0441\u0430\u049B\u0430\u043B"
    speakerLook: elder
    lines:
    - "\u0416\u0435\u0442\u0456\u0441\u0443 \u2014 \u0436\u0435\u0442\u0456 \u04E9\u0437\u0435\u043D\u043D\u0456\u04A3 \u04E9\u043B\u043A\u0435\u0441\u0456. \u0422\u0430\u0443\u044B \u0431\u0438\u0456\u043A, \u0436\u0430\u0439\u043B\u0430\u0443\u044B \u0448\u04AF\u0439\u0433\u0456\u043D."
    - "\u0428\u0443 \u043C\u0435\u043D \u0422\u0430\u043B\u0430\u0441 \u0431\u043E\u0439\u044B\u043D\u0434\u0430 \u043C\u0430\u043B\u0493\u0430 \u0434\u0430 \u0436\u0435\u0440 \u0436\u0435\u0442\u0435\u0434\u0456."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_T3
    speakerName: "\u0410\u049B\u0441\u0430\u049B\u0430\u043B"
    speakerLook: elder
    lines:
    - "\u0421\u043E\u049B\u044B\u0440 \u0442\u0435\u043A\u0435 \u2014 \u0431\u0430\u043B\u0430\u043D\u044B\u04A3 \u049B\u04B1\u043B\u0430\u0493\u044B\u043D, \u0441\u0435\u0437\u0456\u043C\u0456\u043D \u0448\u044B\u04A3\u0434\u0430\u0439\u0442\u044B\u043D \u043E\u0439\u044B\u043D."
    - "\u041A\u04E9\u0437\u0456 \u0431\u0430\u0439\u043B\u0430\u0443\u043B\u044B \u0431\u0430\u043B\u0430 \u0434\u044B\u0431\u044B\u0441\u049B\u0430 \u049B\u0430\u0440\u0430\u043F \u0436\u043E\u043B \u0442\u0430\u0431\u0430\u0434\u044B."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_K_ROUTE
    speakerName: "\u0411\u0438"
    speakerLook: bi
    lines:
    - "\u0410\u0443\u044B\u043B \u0434\u0430\u043B\u0430\u0493\u0430 \u0448\u044B\u049B\u0442\u044B, \u0436\u04AF\u043A \u0430\u0440\u0442\u044B\u043B\u0434\u044B."
    - "\u041A\u04E9\u0448 \u0431\u0430\u0493\u044B\u0442\u044B \u2014 \u0428\u0443 \u0431\u043E\u0439\u044B, \u049A\u043E\u0437\u044B\u0431\u0430\u0441\u044B."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: "[\u041F\u0420\u041E\u0412\u0415\u0420\u0418\u0422\u042C] \u049A\u043E\u0437\u044B\u0431\u0430\u0441\u044B \u043A\u0430\u043A \u043C\u0435\u0441\u0442\u043E \u043E\u0442\u043A\u043E\u0447\u0451\u0432\u043A\u0438"
  - id: DIA_A_BI
    speakerName: "\u0411\u0438"
    speakerLook: bi
    lines:
    - "\u0410\u0431\u044B\u043B\u0430\u0439 \u0441\u04B1\u043B\u0442\u0430\u043D, \u0436\u043E\u04A3\u0493\u0430\u0440 \u049B\u0430\u0443\u043F\u0456 \u04D9\u043B\u0456 \u0441\u0435\u0439\u0456\u043B\u0433\u0435\u043D \u0436\u043E\u049B. \u0428\u0435\u043A\u0430\u0440\u0430\u0434\u0430 \u0448\u0430\u043F\u049B\u044B\u043D\u0448\u044B\u043B\u0430\u0440 \u0436\u0438\u0456 \u043A\u04E9\u0440\u0456\u043D\u0435\u0434\u0456."
    - "\u049A\u043E\u043B\u0434\u0430 \u0436\u0430\u0441\u0430\u049B \u0431\u0430\u0440. \u0411\u0456\u0440\u0430\u049B \u0435\u043B \u0431\u044B\u0442\u044B\u0440\u0430\u04A3\u049B\u044B \u2014 \u04D9\u0440 \u0436\u04AF\u0437 \u04E9\u0437 \u049B\u0430\u043C\u044B\u043C\u0435\u043D \u0436\u04AF\u0440."
    - "\u049A\u0430\u043B\u0430\u0439 \u0456\u0441\u0442\u0435\u0439\u043C\u0456\u0437: \u0431\u0456\u0440\u0456\u043D\u0448\u0456 \u0431\u043E\u043B\u044B\u043F \u0441\u043E\u049B\u049B\u044B \u0431\u0435\u0440\u0435\u043C\u0456\u0437 \u0431\u0435, \u04D9\u043B\u0434\u0435 \u043A\u04AF\u0448\u0456\u043C\u0456\u0437\u0434\u0456 \u0431\u0456\u0440\u0456\u043A\u0442\u0456\u0440\u0435\u043C\u0456\u0437 \u0431\u0435?"
    choices:
    - label: "\u0411\u0456\u0440\u0456\u043D\u0448\u0456 \u0431\u043E\u043B\u044B\u043F \u0441\u043E\u049B\u049B\u044B \u0431\u0435\u0440\u0435\u043C\u0456\u0437"
      nextDialogueId: DIA_A_BI_STRIKE
      setFlag: strike
      xp: 10
      unity: 0
    - label: "\u041A\u04AF\u0448\u0456\u043C\u0456\u0437\u0434\u0456 \u0431\u0456\u0440\u0456\u043A\u0442\u0456\u0440\u0435\u0439\u0456\u043A"
      nextDialogueId: DIA_A_BI_UNITE
