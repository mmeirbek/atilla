    speakerLook: envoy2
    lines:
    - "\u0420\u0430\u049B\u043C\u0435\u0442. \u0411\u0430\u0442\u044B\u0440\u043B\u0430\u0440 \u0436\u043E\u043B\u0434\u044B \u043A\u04AF\u0437\u0435\u0442\u0441\u0435, \u043A\u0435\u0440\u0443\u0435\u043D \u0434\u0435, \u0435\u043B \u0434\u0435 \u0442\u044B\u043D\u0430\u0434\u044B."
