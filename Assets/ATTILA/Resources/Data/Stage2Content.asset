  - id: DIA_A_BI_STRIKE
    speakerName: "\u0411\u0438"
    speakerLook: bi
    lines:
    - "\u0416\u04AF\u0440\u0435\u043A \u0431\u0430\u0442\u044B\u043B. \u0411\u0456\u0440\u0430\u049B \u0436\u0430\u043B\u0493\u044B\u0437 \u049B\u043E\u043B\u0434\u0430\u043D \u0448\u0430\u043F\u0430\u043B\u0430\u049B \u0448\u044B\u049B\u043F\u0430\u0441 \u2014 \u0430\u043B\u0434\u044B\u043C\u0435\u043D \u0435\u043B\u0448\u0456\u043B\u0435\u0440\u0434\u0456 \u0442\u044B\u04A3\u0434\u0430\u04A3\u044B\u0437."
