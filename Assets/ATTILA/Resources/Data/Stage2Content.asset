    unlockedDescription: "\u041A\u04E9\u0448 \u2014 \u0430\u0443\u044B\u043B\u0434\u044B\u04A3 \u0436\u0430\u0439\u043B\u0430\u0443\u0493\u0430 \u043D\u0435 \u049B\u044B\u0441\u0442\u0430\u0443\u0493\u0430 \u043A\u04E9\u0448\u0443\u0456. \u041A\u0438\u0456\u0437 \u04AF\u0439 \u0436\u044B\u0493\u044B\u043B\u044B\u043F, \u0442\u04AF\u0439\u0435\u0433\u0435 \u0430\u0440\u0442\u044B\u043B\u0430\u0434\u044B; \u0430\u043B\u0434\u044B\u04A3\u0493\u044B \u043B\u0435\u0433\u0442\u0435 \u049B\u0430\u0440\u0442\u0442\u0430\u0440 \u043C\u0435\u043D \u0431\u0430\u043B\u0430\u043B\u0430\u0440 \u0436\u04AF\u0440\u0435\u0434\u0456."
