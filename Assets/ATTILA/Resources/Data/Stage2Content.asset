    sourceNote: 
  - id: DIA_A_ENVOY_W_FORCE
    speakerName: "\u041A\u0456\u0448\u0456 \u0436\u04AF\u0437 \u0435\u043B\u0448\u0456\u0441\u0456"
    speakerLook: envoy
    lines:
    - "\u041A\u04AF\u0448\u043F\u0435\u043D \u0442\u043E\u049B\u0442\u0430\u0442\u044B\u043B\u0493\u0430\u043D \u0434\u0430\u0443 \u043A\u0435\u0439\u0456\u043D \u049B\u0430\u0439\u0442\u0430 \u04E9\u0440\u0448\u0438\u0434\u0456... \u0411\u0456\u0440\u0430\u049B \u0431\u04B1\u0439\u0440\u044B\u0493\u044B\u04A3\u044B\u0437\u0434\u044B \u0436\u0435\u0442\u043A\u0456\u0437\u0435\u043C\u0456\u043D."
