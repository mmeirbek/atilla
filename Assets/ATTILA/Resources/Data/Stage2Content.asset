  - id: DIA_B_COUNCIL
    speakerName: "\u0416\u04AF\u0437\u0431\u0430\u0441\u044B"
    speakerLook: warrior
    lines:
    - "\u0411\u0430\u0442\u044B\u0440, \u0431\u0430\u0440\u043B\u0430\u0443\u0448\u044B\u043B\u0430\u0440 \u0445\u0430\u0431\u0430\u0440 \u04D9\u043A\u0435\u043B\u0434\u0456: \u0436\u0430\u0443 \u049B\u043E\u043B\u044B \u0430\u0441\u0443\u0434\u0430\u043D \u04E9\u0442\u0443\u0433\u0435 \u0434\u0430\u0439\u044B\u043D\u0434\u0430\u043B\u044B\u043F \u0436\u0430\u0442\u044B\u0440."
    - "\u0416\u0430\u0441\u0430\u049B \u0434\u0430\u0439\u044B\u043D. \u0411\u04B1\u0439\u0440\u044B\u0493\u044B\u04A3\u044B\u0437\u0434\u044B \u043A\u04AF\u0442\u0435\u043C\u0456\u0437."
    choices:
    - label: "\u0416\u0430\u0441\u0430\u049B\u0442\u044B \u0431\u0456\u0440 \u049B\u043E\u043B\u0493\u0430 \u0431\u0456\u0440\u0456\u043A\u0442\u0456\u0440"
      nextDialogueId: DIA_B_FORTIFY
      setFlag: united
      xp: 20
      unity: 40
    - label: "\u0415\u043A\u0456 \u0442\u043E\u043F\u049B\u0430 \u0431\u04E9\u043B\u0456\u043D\u0456\u043F, \u0442\u043E\u0441\u049B\u0430\u0443\u044B\u043B \u049B\u04B1\u0440"
      nextDialogueId: DIA_B_AMBUSH
