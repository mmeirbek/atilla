    speakerName: "\u041A\u0456\u0448\u0456 \u0436\u04AF\u0437 \u0435\u043B\u0448\u0456\u0441\u0456"
    speakerLook: envoy
    lines:
    - "\u0411\u04B1\u043B \u2014 \u0431\u0438\u0434\u0456\u04A3 \u0434\u0435, \u0445\u0430\u043D\u043D\u044B\u04A3 \u0434\u0430 \u0436\u043E\u043B\u044B. \u0411\u0456\u0437 \u0431\u0456\u0440\u043B\u0456\u043A\u043A\u0435 \u049B\u043E\u0441\u044B\u043B\u0430\u043C\u044B\u0437."
