    lockedDescription: "\u041E\u0439\u044B\u043D \u0431\u0430\u0440\u044B\u0441\u044B\u043D\u0434\u0430 \u0430\u0448\u044B\u043B\u0430\u0434\u044B."
    unlockedDescription: "XVIII \u0493\u0430\u0441\u044B\u0440\u0434\u0430\u0493\u044B \u049B\u0430\u0437\u0430\u049B \u0445\u0430\u043D\u044B, \u049B\u043E\u043B\u0431\u0430\u0441\u0448\u044B \u04D9\u0440\u0456 \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442. \u0416\u043E\u04A3\u0493\u0430\u0440, \u0426\u0438\u043D \u0436\u04D9\u043D\u0435 \u0420\u0435\u0441\u0435\u0439 \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430 \u0435\u043B\u0434\u0456\u04A3 \u0434\u0435\u0440\u0431\u0435\u0441\u0442\u0456\u0433\u0456\u043D \u0441\u0430\u049B\u0442\u0430\u0443\u0493\u0430 \u0442\u044B\u0440\u044B\u0441\u0442\u044B. 1771 \u0436\u044B\u043B\u044B \u0422\u04AF\u0440\u043A\u0456\u0441\u0442\u0430\u043D\u0434\u0430 \u0445\u0430\u043D \u0441\u0430\u0439\u043B\u0430\u043D\u0434\u044B."
    status: 0
    sourceNote: "[\u041F\u0420\u041E\u0412\u0415\u0420\u0418\u0422\u042C] \u0433\u043E\u0434\u044B \u0436\u0438\u0437\u043D\u0438 (1711\u20131781), \u0438\u0437\u0431\u0440\u0430\u043D\u0438\u0435 \u0432 1771 \u0433. \u0432 \u0422\u0443\u0440\u043A\u0435\u0441\u0442\u0430\u043D\u0435"
