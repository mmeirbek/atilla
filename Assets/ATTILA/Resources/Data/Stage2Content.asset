  - id: DIA_A_T1
    speakerName: "\u0410\u049B\u0441\u0430\u049B\u0430\u043B"
    speakerLook: elder
    lines:
    - "1723 \u0436\u044B\u043B\u044B \u0436\u043E\u04A3\u0493\u0430\u0440\u043B\u0430\u0440 \u043A\u0435\u043D\u0435\u0442\u0442\u0435\u043D \u0448\u0430\u0431\u0443\u044B\u043B \u0436\u0430\u0441\u0430\u0434\u044B. \u0415\u043B \u0430\u0443\u044B\u0440 \u043A\u04AF\u0439\u0433\u0435 \u0442\u04AF\u0441\u0442\u0456."
    - "\u0425\u0430\u043B\u044B\u049B \u043E\u043B \u0436\u044B\u043B\u0434\u0430\u0440\u0434\u044B \xAB\u0410\u049B\u0442\u0430\u0431\u0430\u043D \u0448\u04B1\u0431\u044B\u0440\u044B\u043D\u0434\u044B\xBB \u0434\u0435\u043F \u0430\u0442\u0430\u0434\u044B."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: "[\u041F\u0420\u041E\u0412\u0415\u0420\u0418\u0422\u042C] 1723 \u0433\u043E\u0434 \u0438 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \xAB\u0410\u049B\u0442\u0430\u0431\u0430\u043D \u0448\u04B1\u0431\u044B\u0440\u044B\u043D\u0434\u044B\xBB"
