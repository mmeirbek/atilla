  - id: DIA_B_SCOUT
    speakerName: "\u0411\u0430\u0440\u043B\u0430\u0443\u0448\u044B"
    speakerLook: envoy
    lines:
    - "\u0416\u0430\u0443 \u0431\u0430\u0442\u044B\u0440\u044B \u0435\u043A\u0456 \u049B\u043E\u043B\u0434\u044B\u04A3 \u0430\u043B\u0434\u044B\u043D\u0430 \u0448\u044B\u0493\u044B\u043F, \u0436\u0435\u043A\u043F\u0435-\u0436\u0435\u043A\u043A\u0435 \u0448\u0430\u049B\u044B\u0440\u0434\u044B!"
    - "\u0410\u0442\u0430 \u0434\u04D9\u0441\u0442\u04AF\u0440 \u0431\u043E\u0439\u044B\u043D\u0448\u0430 \u04B1\u0440\u044B\u0441 \u0436\u0435\u043A\u043F\u0435-\u0436\u0435\u043A\u0442\u0435\u043D \u0431\u0430\u0441\u0442\u0430\u043B\u0430\u0434\u044B."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
