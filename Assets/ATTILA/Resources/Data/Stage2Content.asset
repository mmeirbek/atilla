    speakerLook: resident
    lines:
    - "\u0421\u0430\u0443\u044B\u0442\u044B\u04A3\u044B\u0437 \u0436\u04E9\u043D\u0434\u0435\u043B\u0434\u0456, \u043D\u0430\u0439\u0437\u0430\u04A3\u044B\u0437 \u049B\u0430\u0439\u0440\u0430\u043B\u0434\u044B."
    - "\u041C\u044B\u043D\u0430 \u0448\u0430\u043F\u0430\u043D\u0434\u044B \u0434\u0430 \u0430\u043B\u044B\u04A3\u044B\u0437 \u2014 \u0442\u0430\u0443\u043B\u044B \u0436\u0435\u0440\u0434\u0435 \u0442\u04AF\u043D \u0441\u0443\u044B\u049B."
