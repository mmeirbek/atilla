  - id: DIA_A_BI_UNITE
    speakerName: "\u0411\u0438"
    speakerLook: bi
    lines:
    - "\u0414\u04B1\u0440\u044B\u0441 \u0448\u0435\u0448\u0456\u043C. \u04AE\u0448 \u0436\u04AF\u0437\u0434\u0456\u04A3 \u0431\u0430\u0441\u044B \u049B\u043E\u0441\u044B\u043B\u0441\u0430, \u0436\u0430\u0443 \u0430\u043B\u043C\u0430\u0439\u0442\u044B\u043D \u049B\u0430\u043C\u0430\u043B \u0436\u043E\u049B. \u0415\u043B\u0448\u0456\u043B\u0435\u0440 \u0441\u0456\u0437\u0434\u0456 \u043A\u04AF\u0442\u0456\u043F \u0442\u04B1\u0440."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_A_ENVOY_W
    speakerName: "\u041A\u0456\u0448\u0456 \u0436\u04AF\u0437 \u0435\u043B\u0448\u0456\u0441\u0456"
    speakerLook: envoy
    lines:
    - "\u0421\u04B1\u043B\u0442\u0430\u043D, \u0431\u0456\u0437\u0434\u0456\u04A3 \u0430\u0443\u044B\u043B\u0434\u0430\u0440 \u0436\u0430\u0439\u044B\u043B\u044B\u043C \u04AF\u0448\u0456\u043D \u043A\u04E9\u0440\u0448\u0456\u043B\u0435\u0440\u0456\u043C\u0435\u043D \u0434\u0430\u0443\u043B\u0430\u0441\u044B\u043F \u0436\u04AF\u0440."
    - "\u04D8\u0434\u0456\u043B \u0442\u04E9\u0440\u0435\u043B\u0456\u043A \u0430\u0439\u0442\u0441\u0430\u04A3\u044B\u0437, \u0435\u043B \u0441\u0456\u0437\u0433\u0435 \u049B\u04B1\u043B\u0430\u049B \u0430\u0441\u0430\u0434\u044B."
    choices:
    - label: "\u0415\u043A\u0456 \u0436\u0430\u049B\u0442\u044B \u0434\u0430 \u0442\u044B\u04A3\u0434\u0430\u043F, \u04D9\u0434\u0456\u043B \u0431\u0456\u0442\u0456\u043C \u0430\u0439\u0442\u0430\u043C\u044B\u043D"
      nextDialogueId: DIA_A_ENVOY_W_FAIR
      setFlag: fair
      xp: 20
      unity: 30
    - label: "\u041A\u04AF\u0448\u0442\u0456\u043D\u0456\u04A3 \u0441\u04E9\u0437\u0456 \u04E9\u0442\u0435\u0434\u0456"
      nextDialogueId: DIA_A_ENVOY_W_FORCE
