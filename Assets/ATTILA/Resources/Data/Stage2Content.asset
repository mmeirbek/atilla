  - id: DIA_A_HERDER
    speakerName: "\u041C\u0430\u043B\u0448\u044B"
    speakerLook: resident
    lines:
    - "\u0415\u043B\u0448\u0456\u043D\u0456\u04A3 \u0430\u0442\u044B \u0431\u043E\u0441 \u0436\u04AF\u0440, \u0441\u04B1\u043B\u0442\u0430\u043D\u044B\u043C."
    - "\u0410\u0442\u0442\u044B \u0431\u0430\u0493\u0430\u043D\u0430\u0493\u0430 \u0434\u0435\u0439\u0456\u043D \u0436\u0435\u0442\u0435\u043B\u0435\u043F \u0430\u043F\u0430\u0440\u044B\u04A3\u044B\u0437\u0448\u044B \u2014 \u0441\u043E\u04A3\u044B\u04A3\u044B\u0437\u0434\u0430\u043D \u0435\u0440\u0435\u0434\u0456."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_A_BAIGE
    speakerName: "\u041C\u0430\u043B\u0448\u044B"
    speakerLook: resident
    lines:
    - "\u0416\u0438\u044B\u043D \u0430\u043B\u0434\u044B\u043D\u0434\u0430 \u0431\u04D9\u0439\u0433\u0435 \u0431\u0430\u0440, \u0441\u04B1\u043B\u0442\u0430\u043D\u044B\u043C. \u0410\u0443\u044B\u043B \u0436\u0456\u0433\u0456\u0442\u0456 \u0441\u0456\u0437\u0431\u0435\u043D \u0436\u0430\u0440\u044B\u0441\u049B\u044B\u0441\u044B \u043A\u0435\u043B\u0435\u0434\u0456."
    - "\u0411\u0435\u0441 \u0431\u0435\u043B\u0433\u0456\u043D\u0456 \u0440\u0435\u0442\u0456\u043C\u0435\u043D \u0430\u043B\u044B\u043F, \u043C\u04D9\u0440\u0435\u0433\u0435 \u0431\u0456\u0440\u0456\u043D\u0448\u0456 \u0436\u0435\u0442\u0441\u0435\u04A3\u0456\u0437 \u2014 \u0436\u0435\u04A3\u0456\u0441 \u0441\u0456\u0437\u0434\u0456\u043A\u0456."
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_A_CHILDREN
    speakerName: "\u0411\u0430\u043B\u0430\u043B\u0430\u0440"
    speakerLook: child
    lines:
    - "\u0421\u04B1\u043B\u0442\u0430\u043D \u0430\u0493\u0430, \u0441\u0430\u049B\u0430\u04A3\u044B\u0437\u0434\u044B \u0430\u043B\u044B\u04A3\u044B\u0437! \u0410\u0441\u044B\u049B \u0430\u0442\u044B\u043F \u043A\u04E9\u0440\u0435\u0439\u0456\u043A."
    - "\u04AE\u0448 \u0440\u0435\u0442 \u0430\u0442\u0430\u0441\u044B\u0437. \u0415\u043A\u0456 \u0430\u0441\u044B\u049B\u0442\u044B \u0448\u0435\u04A3\u0431\u0435\u0440\u0434\u0435\u043D \u0448\u044B\u0493\u0430\u0440\u0441\u0430\u04A3\u044B\u0437 \u2014 \u0436\u0435\u04A3\u0456\u0441 \u0441\u0456\u0437\u0434\u0456\u043A\u0456!"
    choices: []
    continueLabel: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    status: 0
    sourceNote: 
  - id: DIA_A_ELDER
    speakerName: "\u0410\u049B\u0441\u0430\u049B\u0430\u043B"
    speakerLook: elder
    lines:
    - "\u0415\u0440\u0442\u0435\u04A3 \u04B1\u0437\u0430\u049B \u0436\u043E\u043B. \u0411\u04AF\u0433\u0456\u043D \u043E\u0442 \u0431\u0430\u0441\u044B\u043D\u0434\u0430 \u043E\u0442\u044B\u0440\u044B\u043F, \u0431\u0430\u0431\u0430\u043B\u0430\u0440 \u0441\u04E9\u0437\u0456\u043D \u0442\u044B\u04A3\u0434\u0430\u0439\u044B\u049B."
