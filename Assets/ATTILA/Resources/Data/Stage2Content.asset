  - id: DIA_A_T3
    speakerName: "\u0410\u049B\u0441\u0430\u049B\u0430\u043B"
    speakerLook: elder
    lines:
    - "\u0410\u0441\u044B\u049B \u2014 \u0430\u0443\u044B\u043B \u0431\u0430\u043B\u0430\u0441\u044B\u043D\u044B\u04A3 \u0441\u04AF\u0439\u0456\u043A\u0442\u0456 \u043E\u0439\u044B\u043D\u044B."
    - "\u0421\u0430\u049B\u0430\u043D\u044B \u0434\u04D9\u043B \u0430\u0442\u0443 \u04AF\u0448\u0456\u043D \u043A\u04E9\u0437 \u0434\u0435, \u0448\u044B\u0434\u0430\u043C \u0434\u0430 \u043A\u0435\u0440\u0435\u043A."
